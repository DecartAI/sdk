# Base URL of Decart's managed queue service (provided with your queue setup).
VITE_QUEUE_URL=https://your-assigned-queue-url

# Your line's id and publishable key (provided with your queue setup).
# The publishable key is not a secret — it ships in the app.
VITE_QUEUE_ID=test
VITE_QUEUE_KEY=pk_dev

# YOUR token endpoint (the queue never mints): a tiny backend route that
# mints a short-lived Decart client token with your API key and returns
# { "apiKey": "ek_..." }. See ../express-proxy for the pattern.
VITE_TOKEN_URL=https://your-backend/token
VITE_MODEL=lucy-vton-latest
VITE_MAX_SESSION_SECONDS=120
